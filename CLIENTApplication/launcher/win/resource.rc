            VALUE "OriginalFilename", "GroupBlackNet.exe"
            VALUE "ProductName",      "群档案客户端"
            VALUE "ProductVersion",   "1.0.2"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
